# ============================================================================
#  MonerLeadTracer — wzór konfiguracji.
#  Skopiuj do .env.local i uzupełnij. .env.local NIGDY nie trafia do repo.
#  Na produkcji te same zmienne ustawiasz w panelu Netlify.
# ============================================================================

# --- DOSTĘP DO APLIKACJI (wymagane) ----------------------------------------
# Hasło do całej strony. Bez niego nikt nie wejdzie.
APP_PASSWORD=zmien-mnie
# Losowy sekret do podpisywania ciasteczka sesji. Min. 16 znaków.
# Wygeneruj:  openssl rand -hex 32
SESSION_SECRET=zmien-mnie-na-losowy-ciag-min-16-znakow

# --- BAZA DANYCH ------------------------------------------------------------
# sqlite = plik lokalny (better-sqlite3). turso = baza zdalna (produkcja).
DB_DRIVER=sqlite
DB_PATH=./data/monerleadtracer.db
# Wymagane tylko przy DB_DRIVER=turso:
# TURSO_DATABASE_URL=libsql://twoja-baza.turso.io
# TURSO_AUTH_TOKEN=

# --- GOOGLE PLACES API (New) ------------------------------------------------
# Instrukcja zdobycia klucza krok po kroku: README.md
GOOGLE_PLACES_API_KEY=
PLACES_LANGUAGE=pl
PLACES_REGION=PL
# Ile zapytań do Google wolno wykonać w jednym przebiegu skanu (ochrona portfela).
PLACES_MAX_REQUESTS_PER_RUN=60
# Zapytań na sekundę.
PLACES_RPS=5
# Jak długo trzymamy odpowiedzi w cache (powtórny skan = 0 zapytań i 0 kosztów).
CACHE_TTL_SEARCH_DAYS=7
CACHE_TTL_DETAILS_DAYS=30
# 1 = nie ruszaj sieci, czytaj fixtures/. Pozwala obejrzeć aplikację bez klucza.
DEMO_MODE=0

# --- GENERATOR TEKSTÓW ------------------------------------------------------
# none | gemini | groq | openrouter | anthropic
# none  = szablony offline. Działa od razu, za darmo, bez żadnego klucza.
# gemini = darmowy tier Google AI Studio (to samo konto co Places API).
LLM_PROVIDER=none
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- TWOJA OFERTA (trafia do treści wiadomości) -----------------------------
SENDER_NAME=Krzysiek
OFFER_PRODUCT=prosta strona-wizytówka + uporządkowana wizytówka w Google
OFFER_PRICE=890
OFFER_LEAD_TIME=3-5 dni
OFFER_FREEBIE=podgląd gotowej strony, zanim cokolwiek zapłacicie
